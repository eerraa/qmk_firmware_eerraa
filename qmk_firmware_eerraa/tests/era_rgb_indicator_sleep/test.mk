RGB_MATRIX_ENABLE = yes
RGB_MATRIX_DRIVER = custom
SRC += keyboards/era/common/features/era_rgb_indicator.c
SRC += keyboards/era/common/features/era_lighting_sleep.c
SRC += keyboards/era/common/features/era_rgb_sleep.c
OPT_DEFS += -DRGB_MATRIX_LED_COUNT=2 -DRGB_MATRIX_SLEEP -DENABLE_RGB_MATRIX_SOLID_COLOR
OPT_DEFS += -DRGB_MATRIX_RENDER_POLICY_ENABLE -DRGB_MATRIX_INDICATORS_INDEPENDENT_ENABLE
OPT_DEFS += -DRGB_MATRIX_INDICATORS_WHEN_DISABLED_ENABLE -DERA_RGB_INDICATOR_ENABLE
OPT_DEFS += -DERA_RGB_INDICATOR_1_LED=0 -DERA_RGB_SLEEP_MASTER_ENABLE -DERA_LIGHTING_SLEEP_ENABLE
