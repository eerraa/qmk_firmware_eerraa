{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep|PowerShell|Read|Glob|run_terminal_command|read_file|list_dir|grep",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/hooks/era_pretooluse.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
